<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Five Card Draw Poker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, rgba(34, 197, 94, 0.35), transparent 28rem),
                radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.25), transparent 26rem),
                linear-gradient(135deg, #052e16 0%, #064e3b 48%, #0f172a 100%);
            color: #f8fafc;
        }

        .table-felt {
            background:
                radial-gradient(circle, rgba(255, 255, 255, 0.09) 0 1px, transparent 1px),
                linear-gradient(135deg, rgba(22, 101, 52, 0.95), rgba(6, 78, 59, 0.95));
            background-size: 18px 18px, auto;
            box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.35), 0 30px 80px rgba(0, 0, 0, 0.35);
        }

        .card {
            width: min(17vw, 104px);
            min-width: 58px;
            aspect-ratio: 2.5 / 3.5;
            border-radius: 0.9rem;
            transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
            user-select: none;
        }

        .playing-card {
            background: linear-gradient(145deg, #ffffff, #e2e8f0);
            color: #0f172a;
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 14px 24px rgba(0, 0, 0, 0.22);
        }

        .card-back {
            background:
                linear-gradient(135deg, rgba(255,255,255,0.16) 25%, transparent 25%) 0 0 / 18px 18px,
                linear-gradient(225deg, rgba(255,255,255,0.16) 25%, transparent 25%) 0 0 / 18px 18px,
                linear-gradient(135deg, #1d4ed8, #172554);
            border: 2px solid #bfdbfe;
            box-shadow: 0 14px 24px rgba(0, 0, 0, 0.24);
        }

        .selectable-card:hover {
            transform: translateY(-8px);
            cursor: pointer;
        }

        .selected-card {
            transform: translateY(-18px);
            border-color: #facc15;
            box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.35), 0 20px 30px rgba(0, 0, 0, 0.25);
        }

        .red-suit { color: #dc2626; }
        .black-suit { color: #111827; }
    </style>
</head>
<body class="p-4 md:p-8">
    <main class="mx-auto flex max-w-7xl flex-col gap-6">
        <header class="flex flex-col gap-4 rounded-3xl border border-white/10 bg-slate-950/55 p-5 shadow-2xl backdrop-blur md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.35em] text-emerald-300">Heads-up poker</p>
                <h1 class="mt-1 text-3xl font-extrabold md:text-5xl">Five Card Draw</h1>
                <p class="mt-2 max-w-2xl text-sm text-slate-300 md:text-base">Play one draw round against the computer. Select up to three cards to discard, draw replacements, and reveal the winner.</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <button id="dealButton" class="rounded-full bg-emerald-400 px-6 py-3 font-extrabold text-emerald-950 shadow-lg shadow-emerald-950/30 transition hover:bg-emerald-300">Deal New Hand</button>
                <button id="drawButton" class="rounded-full bg-amber-300 px-6 py-3 font-extrabold text-amber-950 shadow-lg shadow-amber-950/30 transition hover:bg-amber-200 disabled:cursor-not-allowed disabled:opacity-45" disabled>Draw Cards</button>
            </div>
        </header>

        <section class="table-felt rounded-[2rem] border border-emerald-200/20 p-4 md:p-8">
            <div class="grid gap-6 lg:grid-cols-[1fr_320px]">
                <div class="flex flex-col gap-8">
                    <section class="rounded-3xl bg-black/20 p-4 ring-1 ring-white/10">
                        <div class="mb-4 flex items-center justify-between gap-4">
                            <div>
                                <h2 class="text-xl font-extrabold">Computer</h2>
                                <p id="computerStatus" class="text-sm text-slate-300">Hidden hand</p>
                            </div>
                            <span id="computerScore" class="rounded-full bg-slate-950/70 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-300">Waiting</span>
                        </div>
                        <div id="computerHand" class="flex min-h-36 items-center justify-center gap-2 md:gap-4"></div>
                    </section>

                    <section class="rounded-3xl bg-black/20 p-4 ring-1 ring-white/10">
                        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <h2 class="text-xl font-extrabold">Your Hand</h2>
                                <p id="playerStatus" class="text-sm text-slate-300">Deal cards to start.</p>
                            </div>
                            <span id="playerScore" class="rounded-full bg-slate-950/70 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slate-300">Waiting</span>
                        </div>
                        <div id="playerHand" class="flex min-h-36 items-center justify-center gap-2 md:gap-4"></div>
                    </section>
                </div>

                <aside class="flex flex-col gap-4 rounded-3xl bg-slate-950/65 p-5 ring-1 ring-white/10">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.25em] text-emerald-300">Game Log</p>
                        <h2 id="resultTitle" class="mt-2 text-2xl font-extrabold">Ready to deal</h2>
                        <p id="resultText" class="mt-2 text-sm leading-6 text-slate-300">Click “Deal New Hand” to shuffle the deck and play. You can discard up to three cards before the showdown.</p>
                    </div>
                    <div class="rounded-2xl bg-white/5 p-4 text-sm text-slate-300">
                        <h3 class="mb-2 font-bold text-white">How to play</h3>
                        <ol class="list-decimal space-y-2 pl-5">
                            <li>Deal five cards to you and five to the computer.</li>
                            <li>Click your cards to mark up to three discards.</li>
                            <li>Press “Draw Cards” to replace those cards.</li>
                            <li>The computer draws automatically, then both hands are scored.</li>
                        </ol>
                    </div>
                    <div class="rounded-2xl bg-white/5 p-4 text-sm text-slate-300">
                        <h3 class="mb-2 font-bold text-white">Hand rankings</h3>
                        <p>Royal flush, straight flush, four of a kind, full house, flush, straight, three of a kind, two pair, one pair, high card.</p>
                    </div>
                </aside>
            </div>
        </section>
    </main>

    <script>
        const suits = [
            { symbol: '♠', name: 'spades', colorClass: 'black-suit' },
            { symbol: '♥', name: 'hearts', colorClass: 'red-suit' },
            { symbol: '♦', name: 'diamonds', colorClass: 'red-suit' },
            { symbol: '♣', name: 'clubs', colorClass: 'black-suit' }
        ];
        const ranks = [
            { label: '2', value: 2 }, { label: '3', value: 3 }, { label: '4', value: 4 },
            { label: '5', value: 5 }, { label: '6', value: 6 }, { label: '7', value: 7 },
            { label: '8', value: 8 }, { label: '9', value: 9 }, { label: '10', value: 10 },
            { label: 'J', value: 11 }, { label: 'Q', value: 12 }, { label: 'K', value: 13 }, { label: 'A', value: 14 }
        ];
        const rankNames = ['High Card', 'One Pair', 'Two Pair', 'Three of a Kind', 'Straight', 'Flush', 'Full House', 'Four of a Kind', 'Straight Flush', 'Royal Flush'];

        const state = {
            deck: [],
            playerHand: [],
            computerHand: [],
            selectedDiscards: new Set(),
            phase: 'ready'
        };

        const elements = {
            dealButton: document.getElementById('dealButton'),
            drawButton: document.getElementById('drawButton'),
            playerHand: document.getElementById('playerHand'),
            computerHand: document.getElementById('computerHand'),
            playerStatus: document.getElementById('playerStatus'),
            computerStatus: document.getElementById('computerStatus'),
            playerScore: document.getElementById('playerScore'),
            computerScore: document.getElementById('computerScore'),
            resultTitle: document.getElementById('resultTitle'),
            resultText: document.getElementById('resultText')
        };

        function buildDeck() {
            return suits.flatMap(suit => ranks.map(rank => ({ ...rank, suit: suit.symbol, suitName: suit.name, colorClass: suit.colorClass })));
        }

        function shuffle(deck) {
            const shuffled = [...deck];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            return shuffled;
        }

        function drawFromDeck(count) {
            return state.deck.splice(0, count);
        }

        function renderCard(card, index, options = {}) {
            if (options.hidden) {
                return `<div class="card card-back flex items-center justify-center"><span class="text-3xl text-white/75">✦</span></div>`;
            }

            const selected = state.selectedDiscards.has(index);
            const selectableClasses = options.selectable ? 'selectable-card' : '';
            const selectedClasses = selected ? 'selected-card' : '';
            return `
                <button class="card playing-card ${selectableClasses} ${selectedClasses} flex flex-col justify-between p-2 text-left" data-card-index="${index}" aria-label="${card.label} of ${card.suitName}">
                    <span class="text-xl font-extrabold ${card.colorClass}">${card.label}</span>
                    <span class="self-center text-4xl md:text-5xl ${card.colorClass}">${card.suit}</span>
                    <span class="self-end rotate-180 text-xl font-extrabold ${card.colorClass}">${card.label}</span>
                </button>
            `;
        }

        function renderHands(revealComputer = false) {
            elements.playerHand.innerHTML = state.playerHand.map((card, index) => renderCard(card, index, { selectable: state.phase === 'draw' })).join('');
            elements.computerHand.innerHTML = state.computerHand.map((card, index) => renderCard(card, index, { hidden: !revealComputer })).join('');
            elements.drawButton.disabled = state.phase !== 'draw';
        }

        function getCounts(values) {
            return values.reduce((counts, value) => {
                counts[value] = (counts[value] || 0) + 1;
                return counts;
            }, {});
        }

        function getStraightHigh(values) {
            const uniqueValues = [...new Set(values)].sort((a, b) => b - a);
            if (uniqueValues.length !== 5) return null;
            if (uniqueValues.join(',') === '14,5,4,3,2') return 5;
            return uniqueValues[0] - uniqueValues[4] === 4 ? uniqueValues[0] : null;
        }

        function evaluateHand(hand) {
            const values = hand.map(card => card.value).sort((a, b) => b - a);
            const counts = getCounts(values);
            const groups = Object.entries(counts)
                .map(([value, count]) => ({ value: Number(value), count }))
                .sort((a, b) => b.count - a.count || b.value - a.value);
            const isFlush = hand.every(card => card.suit === hand[0].suit);
            const straightHigh = getStraightHigh(values);
            const orderedValues = groups.flatMap(group => Array(group.count).fill(group.value));

            if (isFlush && straightHigh === 14) return { score: [9, 14], name: 'Royal Flush' };
            if (isFlush && straightHigh) return { score: [8, straightHigh], name: 'Straight Flush' };
            if (groups[0].count === 4) return { score: [7, groups[0].value, groups[1].value], name: 'Four of a Kind' };
            if (groups[0].count === 3 && groups[1].count === 2) return { score: [6, groups[0].value, groups[1].value], name: 'Full House' };
            if (isFlush) return { score: [5, ...values], name: 'Flush' };
            if (straightHigh) return { score: [4, straightHigh], name: 'Straight' };
            if (groups[0].count === 3) return { score: [3, ...orderedValues], name: 'Three of a Kind' };
            if (groups[0].count === 2 && groups[1].count === 2) return { score: [2, ...orderedValues], name: 'Two Pair' };
            if (groups[0].count === 2) return { score: [1, ...orderedValues], name: 'One Pair' };
            return { score: [0, ...values], name: rankNames[0] };
        }

        function compareHands(playerEvaluation, computerEvaluation) {
            const maxLength = Math.max(playerEvaluation.score.length, computerEvaluation.score.length);
            for (let i = 0; i < maxLength; i++) {
                const playerValue = playerEvaluation.score[i] || 0;
                const computerValue = computerEvaluation.score[i] || 0;
                if (playerValue > computerValue) return 1;
                if (computerValue > playerValue) return -1;
            }
            return 0;
        }

        function chooseComputerDiscards() {
            const evaluation = evaluateHand(state.computerHand);
            const values = state.computerHand.map(card => card.value);
            const counts = getCounts(values);

            if (evaluation.score[0] >= 4) return [];

            const keepValues = Object.entries(counts)
                .filter(([, count]) => count > 1)
                .map(([value]) => Number(value));

            if (keepValues.length) {
                return state.computerHand
                    .map((card, index) => ({ card, index }))
                    .filter(({ card }) => !keepValues.includes(card.value))
                    .sort((a, b) => a.card.value - b.card.value)
                    .slice(0, 3)
                    .map(({ index }) => index);
            }

            return state.computerHand
                .map((card, index) => ({ card, index }))
                .sort((a, b) => a.card.value - b.card.value)
                .slice(0, 3)
                .map(({ index }) => index);
        }

        function replaceCards(hand, discardIndexes) {
            const replacements = drawFromDeck(discardIndexes.length);
            discardIndexes.forEach((handIndex, replacementIndex) => {
                hand[handIndex] = replacements[replacementIndex];
            });
        }

        function dealNewHand() {
            state.deck = shuffle(buildDeck());
            state.playerHand = drawFromDeck(5);
            state.computerHand = drawFromDeck(5);
            state.selectedDiscards.clear();
            state.phase = 'draw';

            elements.resultTitle.textContent = 'Choose your discards';
            elements.resultText.textContent = 'Click up to three cards to discard, then press “Draw Cards.” Keep all five cards if you like your hand.';
            elements.playerStatus.textContent = 'Select 0–3 cards to discard.';
            elements.computerStatus.textContent = 'Computer is deciding after your draw.';
            elements.playerScore.textContent = 'Draw phase';
            elements.computerScore.textContent = 'Hidden';
            renderHands(false);
        }

        function finishDraw() {
            if (state.phase !== 'draw') return;

            const playerDiscards = [...state.selectedDiscards].sort((a, b) => a - b);
            replaceCards(state.playerHand, playerDiscards);

            const computerDiscards = chooseComputerDiscards();
            replaceCards(state.computerHand, computerDiscards);

            state.selectedDiscards.clear();
            state.phase = 'showdown';

            const playerEvaluation = evaluateHand(state.playerHand);
            const computerEvaluation = evaluateHand(state.computerHand);
            const winner = compareHands(playerEvaluation, computerEvaluation);

            elements.playerScore.textContent = playerEvaluation.name;
            elements.computerScore.textContent = computerEvaluation.name;
            elements.playerStatus.textContent = `You drew ${playerDiscards.length} card${playerDiscards.length === 1 ? '' : 's'}.`;
            elements.computerStatus.textContent = `Computer drew ${computerDiscards.length} card${computerDiscards.length === 1 ? '' : 's'}.`;

            if (winner > 0) {
                elements.resultTitle.textContent = 'You win!';
                elements.resultText.textContent = `Your ${playerEvaluation.name} beats the computer’s ${computerEvaluation.name}. Deal again to play another hand.`;
            } else if (winner < 0) {
                elements.resultTitle.textContent = 'Computer wins';
                elements.resultText.textContent = `The computer’s ${computerEvaluation.name} beats your ${playerEvaluation.name}. Deal again for a rematch.`;
            } else {
                elements.resultTitle.textContent = 'It’s a tie';
                elements.resultText.textContent = `Both hands are tied with ${playerEvaluation.name}. Deal again to settle it.`;
            }

            renderHands(true);
        }

        elements.playerHand.addEventListener('click', event => {
            const cardButton = event.target.closest('[data-card-index]');
            if (!cardButton || state.phase !== 'draw') return;

            const index = Number(cardButton.dataset.cardIndex);
            if (state.selectedDiscards.has(index)) {
                state.selectedDiscards.delete(index);
            } else if (state.selectedDiscards.size < 3) {
                state.selectedDiscards.add(index);
            }

            elements.playerStatus.textContent = `${state.selectedDiscards.size} card${state.selectedDiscards.size === 1 ? '' : 's'} selected to discard.`;
            renderHands(false);
        });

        elements.dealButton.addEventListener('click', dealNewHand);
        elements.drawButton.addEventListener('click', finishDraw);
        dealNewHand();
    </script>
</body>
</html>
