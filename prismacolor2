<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tiny Piano Teacher</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');

        :root {
            --piano-black: #101827;
            --piano-white: #fffdf7;
            --accent: #7c3aed;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', sans-serif;
            color: #eef2ff;
            background:
                radial-gradient(circle at top left, rgba(124, 58, 237, 0.36), transparent 34rem),
                radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.28), transparent 30rem),
                linear-gradient(135deg, #080b18 0%, #111827 52%, #161129 100%);
        }

        .glass {
            background: rgba(15, 23, 42, 0.78);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
            backdrop-filter: blur(18px);
        }

        .song-card {
            transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
        }

        .song-card:hover, .song-card.active {
            transform: translateY(-2px);
            border-color: rgba(167, 139, 250, 0.95);
            background: rgba(91, 33, 182, 0.32);
        }

        .keyboard {
            position: relative;
            height: 15rem;
            width: min(100%, 960px);
            margin-inline: auto;
            user-select: none;
            touch-action: manipulation;
        }

        .white-key {
            position: relative;
            z-index: 1;
            height: 15rem;
            flex: 1 1 0;
            min-width: 2.75rem;
            border: 1px solid #cbd5e1;
            border-bottom-width: 6px;
            border-radius: 0 0 0.85rem 0.85rem;
            background: linear-gradient(180deg, #ffffff 0%, var(--piano-white) 72%, #e2e8f0 100%);
            color: #334155;
            box-shadow: inset 0 -8px 12px rgba(15, 23, 42, 0.10);
            transition: transform 0.08s ease, background 0.08s ease, box-shadow 0.08s ease;
        }

        .black-key {
            position: absolute;
            z-index: 3;
            top: 0;
            width: clamp(2rem, 5vw, 3.5rem);
            height: 9.3rem;
            transform: translateX(-50%);
            border: 1px solid #020617;
            border-bottom-width: 7px;
            border-radius: 0 0 0.65rem 0.65rem;
            background: linear-gradient(180deg, #334155 0%, var(--piano-black) 78%, #020617 100%);
            color: #e2e8f0;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.42), inset 0 -8px 12px rgba(0, 0, 0, 0.38);
            transition: transform 0.08s ease, background 0.08s ease, box-shadow 0.08s ease;
        }

        .white-key.playing, .white-key.lesson-target {
            background: linear-gradient(180deg, #fef3c7 0%, #fde68a 82%, #f59e0b 100%);
            box-shadow: 0 0 30px rgba(245, 158, 11, 0.48), inset 0 -7px 12px rgba(146, 64, 14, 0.18);
            transform: translateY(3px);
        }

        .black-key.playing, .black-key.lesson-target {
            background: linear-gradient(180deg, #a78bfa 0%, #6d28d9 72%, #3b0764 100%);
            box-shadow: 0 0 30px rgba(167, 139, 250, 0.58), inset 0 -8px 12px rgba(46, 16, 101, 0.38);
            transform: translateX(-50%) translateY(3px);
        }

        .note-pill {
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(30, 41, 59, 0.82);
        }

        .note-pill.current {
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            color: white;
            box-shadow: 0 0 22px rgba(245, 158, 11, 0.45);
        }

        .note-pill.done {
            background: rgba(34, 197, 94, 0.22);
            color: #bbf7d0;
            border-color: rgba(74, 222, 128, 0.46);
        }
    </style>
</head>
<body>
    <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col gap-6 px-4 py-6 lg:px-8">
        <header class="glass rounded-3xl p-6 md:p-8">
            <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
                <div>
                    <p class="mb-2 text-sm font-bold uppercase tracking-[0.35em] text-violet-300">Interactive music coach</p>
                    <h1 class="text-4xl font-extrabold tracking-tight md:text-6xl">Tiny Piano Teacher</h1>
                    <p class="mt-3 max-w-3xl text-slate-300">Learn beginner piano by following highlighted keys, playing along with note names, and practicing 10 simple songs at your own speed.</p>
                </div>
                <div class="grid grid-cols-3 gap-3 text-center">
                    <div class="rounded-2xl bg-white/10 px-4 py-3">
                        <p class="text-3xl font-black" id="scoreDisplay">0</p>
                        <p class="text-xs uppercase tracking-widest text-slate-300">Score</p>
                    </div>
                    <div class="rounded-2xl bg-white/10 px-4 py-3">
                        <p class="text-3xl font-black" id="streakDisplay">0</p>
                        <p class="text-xs uppercase tracking-widest text-slate-300">Streak</p>
                    </div>
                    <div class="rounded-2xl bg-white/10 px-4 py-3">
                        <p class="text-3xl font-black" id="tempoDisplay">90</p>
                        <p class="text-xs uppercase tracking-widest text-slate-300">BPM</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="grid gap-6 lg:grid-cols-[360px_1fr]">
            <aside class="glass rounded-3xl p-5">
                <div class="mb-5 flex items-center justify-between gap-3">
                    <div>
                        <h2 class="text-xl font-bold">Songbook</h2>
                        <p class="text-sm text-slate-400">Pick one of 10 easy melodies.</p>
                    </div>
                    <span class="rounded-full bg-violet-500/20 px-3 py-1 text-xs font-bold text-violet-200">10 songs</span>
                </div>
                <div id="songList" class="grid max-h-[34rem] gap-3 overflow-y-auto pr-1"></div>
            </aside>

            <section class="glass rounded-3xl p-5 md:p-6">
                <div class="mb-6 grid gap-4 xl:grid-cols-[1fr_auto] xl:items-end">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.25em] text-sky-300">Current lesson</p>
                        <h2 id="songTitle" class="mt-2 text-3xl font-extrabold">Twinkle Twinkle</h2>
                        <p id="songDescription" class="mt-2 text-slate-300">Practice the first phrase using C, D, E, F, G and A.</p>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <button id="playDemoBtn" class="rounded-2xl bg-sky-500 px-5 py-3 font-bold text-white shadow-lg shadow-sky-950/30 transition hover:bg-sky-400">
                            <i class="fas fa-play mr-2"></i>Play Demo
                        </button>
                        <button id="startLessonBtn" class="rounded-2xl bg-violet-600 px-5 py-3 font-bold text-white shadow-lg shadow-violet-950/30 transition hover:bg-violet-500">
                            <i class="fas fa-graduation-cap mr-2"></i>Start Lesson
                        </button>
                        <button id="resetLessonBtn" class="rounded-2xl bg-slate-700 px-5 py-3 font-bold text-white transition hover:bg-slate-600">
                            <i class="fas fa-rotate-left mr-2"></i>Reset
                        </button>
                    </div>
                </div>

                <div class="mb-5 grid gap-4 md:grid-cols-[1fr_260px]">
                    <div class="rounded-3xl bg-slate-950/50 p-4">
                        <div class="mb-3 flex items-center justify-between gap-3">
                            <span class="text-sm font-bold uppercase tracking-widest text-slate-400">Note path</span>
                            <span id="lessonStatus" class="rounded-full bg-emerald-500/15 px-3 py-1 text-xs font-bold text-emerald-200">Choose a song and start</span>
                        </div>
                        <div id="notePath" class="flex flex-wrap gap-2"></div>
                    </div>
                    <div class="rounded-3xl bg-slate-950/50 p-4">
                        <label for="tempoInput" class="mb-2 flex items-center justify-between text-sm font-bold uppercase tracking-widest text-slate-400">
                            Tempo
                            <span id="tempoLabel" class="text-sky-200">90 BPM</span>
                        </label>
                        <input id="tempoInput" type="range" min="50" max="140" value="90" class="w-full accent-violet-500">
                        <p class="mt-4 text-sm text-slate-400">Tip: use keyboard keys A–K for the white keys and W, E, T, Y, U for black keys.</p>
                    </div>
                </div>

                <div class="keyboard" aria-label="Interactive piano keyboard">
                    <div id="whiteKeys" class="flex h-full"></div>
                    <div id="blackKeys"></div>
                </div>
            </section>
        </section>
    </main>

    <script>
        const whiteNotes = ['C4', 'D4', 'E4', 'F4', 'G4', 'A4', 'B4', 'C5'];
        const blackNotes = [
            { note: 'C#4', left: 12.5 },
            { note: 'D#4', left: 25 },
            { note: 'F#4', left: 50 },
            { note: 'G#4', left: 62.5 },
            { note: 'A#4', left: 75 }
        ];
        const keyMap = {
            a: 'C4', s: 'D4', d: 'E4', f: 'F4', g: 'G4', h: 'A4', j: 'B4', k: 'C5',
            w: 'C#4', e: 'D#4', t: 'F#4', y: 'G#4', u: 'A#4'
        };
        const noteNames = {
            'C4': 'C', 'C#4': 'C♯', 'D4': 'D', 'D#4': 'D♯', 'E4': 'E', 'F4': 'F',
            'F#4': 'F♯', 'G4': 'G', 'G#4': 'G♯', 'A4': 'A', 'A#4': 'A♯', 'B4': 'B', 'C5': 'High C'
        };
        const frequencies = {
            'C4': 261.63, 'C#4': 277.18, 'D4': 293.66, 'D#4': 311.13, 'E4': 329.63,
            'F4': 349.23, 'F#4': 369.99, 'G4': 392.00, 'G#4': 415.30, 'A4': 440.00,
            'A#4': 466.16, 'B4': 493.88, 'C5': 523.25
        };
        const songs = [
            { title: 'Twinkle Twinkle', level: 'Starter', description: 'Practice the first phrase using C, D, E, F, G and A.', notes: ['C4','C4','G4','G4','A4','A4','G4','F4','F4','E4','E4','D4','D4','C4'] },
            { title: 'Mary Had a Little Lamb', level: 'Starter', description: 'Step down and climb back up with E, D and C.', notes: ['E4','D4','C4','D4','E4','E4','E4','D4','D4','D4','E4','G4','G4'] },
            { title: 'Hot Cross Buns', level: 'Starter', description: 'A tiny three-note song for quick wins.', notes: ['E4','D4','C4','E4','D4','C4','C4','C4','C4','C4','D4','D4','D4','D4','E4','D4','C4'] },
            { title: 'Ode to Joy', level: 'Easy', description: 'Learn a famous melody with repeated notes and smooth motion.', notes: ['E4','E4','F4','G4','G4','F4','E4','D4','C4','C4','D4','E4','E4','D4','D4'] },
            { title: 'Jingle Bells', level: 'Easy', description: 'Build rhythm with repeated E notes and a festive ending.', notes: ['E4','E4','E4','E4','E4','E4','E4','G4','C4','D4','E4','F4','F4','F4','F4','F4','E4','E4','E4','E4','D4','D4','E4','D4','G4'] },
            { title: 'London Bridge', level: 'Easy', description: 'Practice descending patterns from G to C.', notes: ['G4','A4','G4','F4','E4','F4','G4','D4','E4','F4','E4','F4','G4','G4','A4','G4','F4','E4','F4','G4','D4','G4','E4','C4'] },
            { title: 'Row Row Row Your Boat', level: 'Easy', description: 'Follow repeated C notes into a gentle climb.', notes: ['C4','C4','C4','D4','E4','E4','D4','E4','F4','G4','C5','C5','C5','G4','G4','G4','E4','E4','E4','C4','C4','C4','G4','F4','E4','D4','C4'] },
            { title: 'Frère Jacques', level: 'Easy', description: 'A round with short patterns that repeat.', notes: ['C4','D4','E4','C4','C4','D4','E4','C4','E4','F4','G4','E4','F4','G4'] },
            { title: 'Amazing Grace', level: 'Gentle', description: 'A slower tune for expressive note changes.', notes: ['C4','F4','A4','F4','A4','G4','F4','D4','C4','F4','A4','F4','A4','G4','C5'] },
            { title: 'Happy Birthday', level: 'Party', description: 'Learn the classic celebration melody.', notes: ['C4','C4','D4','C4','F4','E4','C4','C4','D4','C4','G4','F4','C4','C4','C5','A4','F4','E4','D4','A#4','A#4','A4','F4','G4','F4'] }
        ];

        const els = {
            songList: document.getElementById('songList'),
            songTitle: document.getElementById('songTitle'),
            songDescription: document.getElementById('songDescription'),
            notePath: document.getElementById('notePath'),
            whiteKeys: document.getElementById('whiteKeys'),
            blackKeys: document.getElementById('blackKeys'),
            playDemoBtn: document.getElementById('playDemoBtn'),
            startLessonBtn: document.getElementById('startLessonBtn'),
            resetLessonBtn: document.getElementById('resetLessonBtn'),
            lessonStatus: document.getElementById('lessonStatus'),
            scoreDisplay: document.getElementById('scoreDisplay'),
            streakDisplay: document.getElementById('streakDisplay'),
            tempoInput: document.getElementById('tempoInput'),
            tempoDisplay: document.getElementById('tempoDisplay'),
            tempoLabel: document.getElementById('tempoLabel')
        };

        let audioContext;
        let selectedSongIndex = 0;
        let currentStep = 0;
        let lessonActive = false;
        let score = 0;
        let streak = 0;
        let demoTimers = [];

        function ensureAudio() {
            audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
            if (audioContext.state === 'suspended') audioContext.resume();
            return audioContext;
        }

        function playTone(note, duration = 0.42) {
            const ctx = ensureAudio();
            const oscillator = ctx.createOscillator();
            const gain = ctx.createGain();
            oscillator.type = 'triangle';
            oscillator.frequency.setValueAtTime(frequencies[note], ctx.currentTime);
            gain.gain.setValueAtTime(0.0001, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.42, ctx.currentTime + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
            oscillator.connect(gain).connect(ctx.destination);
            oscillator.start();
            oscillator.stop(ctx.currentTime + duration + 0.03);
        }

        function renderKeyboard() {
            els.whiteKeys.innerHTML = whiteNotes.map(note => `
                <button class="white-key flex items-end justify-center pb-4 font-extrabold" data-note="${note}" aria-label="Play ${noteNames[note]}">
                    <span>${noteNames[note]}</span>
                </button>
            `).join('');
            els.blackKeys.innerHTML = blackNotes.map(({ note, left }) => `
                <button class="black-key flex items-end justify-center pb-3 text-sm font-extrabold" style="left:${left}%" data-note="${note}" aria-label="Play ${noteNames[note]}">
                    <span>${noteNames[note]}</span>
                </button>
            `).join('');
            document.querySelectorAll('[data-note]').forEach(key => {
                key.addEventListener('pointerdown', () => handleNoteInput(key.dataset.note));
            });
        }

        function renderSongs() {
            els.songList.innerHTML = songs.map((song, index) => `
                <button class="song-card ${index === selectedSongIndex ? 'active' : ''} rounded-2xl border border-white/10 p-4 text-left" data-song-index="${index}">
                    <div class="mb-2 flex items-center justify-between gap-3">
                        <h3 class="font-bold text-white">${index + 1}. ${song.title}</h3>
                        <span class="rounded-full bg-slate-950/60 px-2 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-sky-200">${song.level}</span>
                    </div>
                    <p class="text-sm text-slate-400">${song.notes.length} notes • starts on ${noteNames[song.notes[0]]}</p>
                </button>
            `).join('');
            document.querySelectorAll('[data-song-index]').forEach(card => {
                card.addEventListener('click', () => selectSong(Number(card.dataset.songIndex)));
            });
        }

        function renderLesson() {
            const song = songs[selectedSongIndex];
            els.songTitle.textContent = song.title;
            els.songDescription.textContent = song.description;
            els.notePath.innerHTML = song.notes.map((note, index) => `
                <span class="note-pill ${index < currentStep ? 'done' : ''} ${index === currentStep && lessonActive ? 'current' : ''} rounded-full px-3 py-2 text-sm font-black">
                    ${noteNames[note]}
                </span>
            `).join('');
            clearTargets();
            if (lessonActive) highlightTarget(song.notes[currentStep]);
        }

        function selectSong(index) {
            selectedSongIndex = index;
            resetLesson(false);
            renderSongs();
            renderLesson();
        }

        function setStatus(message, className = 'bg-emerald-500/15 text-emerald-200') {
            els.lessonStatus.className = `rounded-full px-3 py-1 text-xs font-bold ${className}`;
            els.lessonStatus.textContent = message;
        }

        function startLesson() {
            stopDemo();
            lessonActive = true;
            currentStep = 0;
            streak = 0;
            updateStats();
            setStatus(`Play ${noteNames[songs[selectedSongIndex].notes[0]]}`);
            renderLesson();
        }

        function resetLesson(showStatus = true) {
            stopDemo();
            lessonActive = false;
            currentStep = 0;
            streak = 0;
            updateStats();
            clearTargets();
            if (showStatus) setStatus('Lesson reset', 'bg-slate-600/50 text-slate-200');
            renderLesson();
        }

        function handleNoteInput(note) {
            stopDemo();
            playTone(note);
            flashKey(note);
            if (!lessonActive) return;

            const expected = songs[selectedSongIndex].notes[currentStep];
            if (note === expected) {
                score += 10;
                streak += 1;
                currentStep += 1;
                if (currentStep >= songs[selectedSongIndex].notes.length) {
                    lessonActive = false;
                    score += 50;
                    setStatus('Song complete! Great job 🎉', 'bg-amber-500/20 text-amber-100');
                    clearTargets();
                } else {
                    setStatus(`Great! Now play ${noteNames[songs[selectedSongIndex].notes[currentStep]]}`);
                }
            } else {
                streak = 0;
                setStatus(`Try ${noteNames[expected]} next`, 'bg-rose-500/20 text-rose-100');
            }
            updateStats();
            renderLesson();
        }

        function updateStats() {
            els.scoreDisplay.textContent = score;
            els.streakDisplay.textContent = streak;
        }

        function flashKey(note, extraClass = 'playing', length = 260) {
            const key = document.querySelector(`[data-note="${note}"]`);
            if (!key) return;
            key.classList.add(extraClass);
            window.setTimeout(() => key.classList.remove(extraClass), length);
        }

        function highlightTarget(note) {
            const key = document.querySelector(`[data-note="${note}"]`);
            if (key) key.classList.add('lesson-target');
        }

        function clearTargets() {
            document.querySelectorAll('.lesson-target').forEach(key => key.classList.remove('lesson-target'));
        }

        function playDemo() {
            stopDemo();
            lessonActive = false;
            currentStep = 0;
            renderLesson();
            const interval = 60000 / Number(els.tempoInput.value);
            setStatus('Demo is playing...', 'bg-sky-500/20 text-sky-100');
            songs[selectedSongIndex].notes.forEach((note, index) => {
                const timer = window.setTimeout(() => {
                    playTone(note, Math.min(0.5, interval / 1000 * 0.85));
                    flashKey(note, 'playing', Math.max(220, interval * 0.72));
                    highlightDemoNote(index);
                    if (index === songs[selectedSongIndex].notes.length - 1) {
                        demoTimers.push(window.setTimeout(() => setStatus('Demo finished. Start the lesson when ready!'), interval));
                    }
                }, index * interval);
                demoTimers.push(timer);
            });
        }

        function highlightDemoNote(activeIndex) {
            [...els.notePath.children].forEach((pill, index) => {
                pill.classList.toggle('current', index === activeIndex);
                pill.classList.toggle('done', index < activeIndex);
            });
        }

        function stopDemo() {
            demoTimers.forEach(timer => window.clearTimeout(timer));
            demoTimers = [];
        }

        els.playDemoBtn.addEventListener('click', playDemo);
        els.startLessonBtn.addEventListener('click', startLesson);
        els.resetLessonBtn.addEventListener('click', resetLesson);
        els.tempoInput.addEventListener('input', () => {
            const bpm = els.tempoInput.value;
            els.tempoDisplay.textContent = bpm;
            els.tempoLabel.textContent = `${bpm} BPM`;
        });
        window.addEventListener('keydown', event => {
            const note = keyMap[event.key.toLowerCase()];
            if (!note || event.repeat) return;
            event.preventDefault();
            handleNoteInput(note);
        });

        renderKeyboard();
        renderSongs();
        renderLesson();
    </script>
</body>
</html>
